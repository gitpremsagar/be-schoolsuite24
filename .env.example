DATABASE_URL=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/DATABASE?retryWrites=true&w=majority

# JWT Authentication
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
# Cookie max-age in milliseconds (default: 7 days)
REFRESH_COOKIE_MAX_AGE=604800000

# Deep link encoded in the staff punch QR poster (teacher app scheme)
STAFF_PUNCH_QR_LINK_BASE=mobileteacher://qr-punch

# DeepSeek AI (chapter content extraction)
# Get a key from https://platform.deepseek.com and keep it server-side only.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Maximum time to wait for one chapter generation (milliseconds)
DEEPSEEK_TIMEOUT_MS=300000
# Per-school AI generation limit per rolling hour
AI_GENERATIONS_PER_HOUR=20

# Platform Super Admin (used by: npm run db:seed)
SUPER_ADMIN_EMAIL=superadmin@schoolerp.local
SUPER_ADMIN_PASSWORD=SuperAdmin123!
SUPER_ADMIN_NAME=Platform Super Admin
# Set to true to reset password/name for an existing SUPER_ADMIN_EMAIL
# SUPER_ADMIN_RESET=true

# Web app origin used in emails (password reset links)
APP_URL=http://localhost:3000
# Password reset link lifetime in minutes
PASSWORD_RESET_TTL_MINUTES=15

# SMTP for outgoing email (password reset).
# Leave SMTP_HOST empty in development to print emails to the server console.
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS); false for 587/25 with STARTTLS
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# From address; defaults to SMTP_USER when empty
MAIL_FROM=
# Set to false only for test relays with self-signed certificates
# SMTP_TLS_REJECT_UNAUTHORIZED=true
