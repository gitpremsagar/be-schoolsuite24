DATABASE_URL=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/DATABASE?retryWrites=true&w=majority

# JWT Authentication
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
# Cookie max-age in milliseconds (default: 7 days)
REFRESH_COOKIE_MAX_AGE=604800000

# Deep link encoded in the staff punch QR poster (teacher app scheme)
STAFF_PUNCH_QR_LINK_BASE=mobileteacher://qr-punch

# Platform Super Admin (used by: npm run db:seed)
SUPER_ADMIN_EMAIL=superadmin@schoolerp.local
SUPER_ADMIN_PASSWORD=SuperAdmin123!
SUPER_ADMIN_NAME=Platform Super Admin
# Set to true to reset password/name for an existing SUPER_ADMIN_EMAIL
# SUPER_ADMIN_RESET=true
